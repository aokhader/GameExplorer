{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "metro",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gameexplorer/mobile",
        "exec",
        "expo",
        "start",
        "--dev-client",
        "--clear",
        "--port",
        "8081"
      ],
      "port": 8081,
      "autoPort": false
    }
  ]
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Native build output — CMake/NDK regenerates this per machine and the
# fingerprints embed absolute local toolchain paths.
**/.cxx/

# Misc
.DS_Store
*.pem
project-docs/
.vscode/

# Puzzle corpus: the derived JSONL is committed, the raw dumps never are.
# The Lichess CSV is ~250MB and its provenance is recorded in
# data/puzzles/LICENSE-lichess.md rather than by vendoring the file.
data/puzzles/*.csv

# Mining lock files. One miner per game at a time; the lock is process state,
# never content, and a stale one committed would block everyone else's run.
data/puzzles/.*.mining.lock

# Per-run calibration checkpoints. One per worker, merged into calibration.json
# when the run finishes; they exist so an interrupted run is resumable, not so
# anyone reads them.
data/puzzles/calibration.shard-*.json

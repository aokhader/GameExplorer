# Flat, real node_modules instead of pnpm's deep `.pnpm` virtual store + junctions.
#
# WHY: The RN app (apps/mobile) compiles native C++ (reanimated, gesture-handler,
# svg, screens, and later Stockfish). With pnpm's default `isolated` linker,
# packages resolve to junctions pointing into
#   node_modules/.pnpm/<pkg>@<version>_<115-char-peer-hash>/node_modules/<pkg>
# CMake writes object files inside that real path and appends the doubled source
# path on top, producing ~450-char paths that blow past Windows MAX_PATH (260)
# and the SDK's non-long-path-aware ninja (cmake 3.22.1). Hoisting removes the
# 221-char `.pnpm` prefix so native builds fit. See mobile plan / M0 notes.
node-linker=hoisted

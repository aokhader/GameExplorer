# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# Supabase JWT verification (REQUIRED for WebSocket/multiplayer auth)
# Tokens are signed with an asymmetric (ECC / ES256) key. The auth middleware
# verifies them against the project's public JWKS endpoint, derived as
# `${SUPABASE_URL}/auth/v1/.well-known/jwks.json` (keys are fetched + cached, and
# re-fetched automatically on rotation). If SUPABASE_URL is missing, EVERY socket
# connection is rejected with "Server misconfiguration" and clients hang on
# "Connecting…". This is your project URL, e.g. https://abcdefgh.supabase.co
# (Supabase Dashboard → Project Settings → Data API → Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret API key (REQUIRED for server-side persistence of multiplayer
# results — ratings + game records for both players). Bypasses RLS; keep it
# server-only, NEVER ship it to the web app or commit it.
# (Supabase Dashboard → Project Settings → API Keys → Secret keys → sb_secret_...)
# The legacy service_role JWT also works here (or via SUPABASE_SERVICE_ROLE_KEY),
# but secret keys are revocable and the recommended replacement.
SUPABASE_SECRET_KEY=your-supabase-secret-api-key-change-in-production

# Database (Prisma 7 - configured in prisma.config.ts)
# Credentials below match docker-compose.yaml (postgres service). If you change
# them here, change them there too — a mismatch causes ECONNREFUSED/auth errors.
#
# The Prisma schema owns ONLY `friendships` (everything else lives in Supabase
# or Redis). In PRODUCTION, point this at the Supabase Postgres connection
# string (Dashboard → Connect → Session pooler) so there is one database —
# but create the table there with project-docs/supabase-friendships.sql.
# NEVER run `prisma db push` against Supabase: it drops tables the pruned
# schema doesn't know about (games, user_ratings, ...). db:push is for the
# local docker-compose Postgres only.
DATABASE_URL="postgresql://gameexplorer:5_game_explorer_dev_password_7@localhost:5432/gameexplorer_db?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-key-change-in-production-use-openssl-rand-base64-32
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-secret-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# AWS S3 (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your-session-secret-change-in-production

# Production optimizations
MAX_REQUEST_SIZE=10mb
ENABLE_COMPRESSION=true
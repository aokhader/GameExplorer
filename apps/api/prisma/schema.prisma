// Prisma schema for the API's OWN tables only.
//
// The API deliberately owns just `Friendship`. Users, ratings, and completed
// games live in Supabase (written via the service-role client in
// src/services/persistence.service.ts and read by the web app); live game /
// clock / queue state lives in Redis. Do NOT re-add models that mirror
// Supabase tables — that duplication is what this prune removed (spec §Phase 4
// Schema, tech-spec-v3.md).
//
// WARNING: `prisma db push` makes the database match this schema, DROPPING
// tables it doesn't list. Only run it against the local docker-compose
// Postgres. In production DATABASE_URL points at Supabase Postgres — create
// the table there with project-docs/supabase-friendships.sql instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The URL is now in prisma.config.ts
}

model Friendship {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.Uuid
  friendId    String   @map("friend_id") @db.Uuid
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, friendId])
  @@map("friendships")
}

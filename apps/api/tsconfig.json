{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS so `node dist/index.js` works directly. `module: esnext` emitted
    // extensionless ESM imports that only tsx/bundlers can resolve — plain Node
    // crashed with ERR_MODULE_NOT_FOUND in production. Node 22 can require()
    // ESM-only deps (jose), so CJS output is safe here.
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}